{
  "manifest_version": 3,
  "name": "MarkBrew",
  "version": "1.0.1",
  "description": "A productivity dashboard and bookmark organizer for your new tab.",
  "permissions": ["bookmarks", "storage", "geolocation", "favicon", "contextMenus", "scripting", "tabGroups", "tabs", "sessions", "system.memory", "system.cpu"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_title": "MarkBrew",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "favicon.svg"
  }
}
